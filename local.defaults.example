# Vorlage fuer die eigene Anlage. Kopieren und ausfuellen:
#     cp local.defaults.example local.defaults
# "local.defaults" steht in der .gitignore und wird nicht veroeffentlicht.

# --- WLAN ---
CONFIG_PVMON_WIFI_SSID="MeinWLAN"
CONFIG_PVMON_WIFI_PASS="MeinPasswort"

# --- Anlage ---
# Maximale Leistung, die am Plug ankommen kann. Skaliert den Ring.
CONFIG_PVMON_INVERTER_LIMIT_W=800

# --- Stufe 2: Shelly Pro 3EM (optional) ---
#CONFIG_PVMON_EM_ENABLE=y
# Sitzt ein Batteriespeicher zwischen dem gemessenen Wechselrichter und dem
# Netzuebergabepunkt? Dann ist der Hausverbrauch nicht ableitbar und der
# Monitor zeigt stattdessen, ob die Anlage das Haus gerade traegt.
#CONFIG_PVMON_STORAGE_BETWEEN=y

# IPs koennen leer bleiben -- dann sucht der Monitor die Geraete per mDNS.
#CONFIG_PVMON_PLUG_HOST="192.168.1.31"
#CONFIG_PVMON_EM_HOST="192.168.1.23"

# --- Stufe 3: Speicher über Home Assistant (optional) ---
#CONFIG_PVMON_HA_ENABLE=y
#CONFIG_PVMON_HA_HOST="192.168.1.50:8123"
#CONFIG_PVMON_HA_TOKEN="eyJhbGciOi..."
#CONFIG_PVMON_HA_ENTITY_SOC="sensor.speicher_ladezustand"
#CONFIG_PVMON_HA_ENTITY_POWER="sensor.speicher_leistung"
#CONFIG_PVMON_HA_POWER_INVERT=y
#CONFIG_PVMON_HA_CAPACITY_WH=2000
